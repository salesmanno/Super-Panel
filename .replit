modules = ["php", "php-8.2", "python-3.11", "python3", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["php82Extensions.zip", "imagemagick", "php82Extensions.imap", "mysql80", "php82Extensions.pdo_pgsql", "php82Extensions.pgsql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Email Queue Processor"

[[workflows.workflow]]
name = "PHP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 -t ."
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Email Queue Processor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "while true; do php cron_email_queue.php; sleep 60; done"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5100
externalPort = 3000

[agent]
expertMode = true

[deployment]
run = ["sh", "-c", '''bash -c 'printf "%s\n\n%s" "$0" "$1"' "First argument" "Second argument"''']
deploymentTarget = "cloudrun"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
